{% extends 'base.html.twig' %}

{% block title %}Patient Login{% endblock %}

{% block stylesheets %}
    <style>
        body {
            margin: 0;
            padding: 0;
 background: url('{{ asset("images/patient-bg.jpg") }}') no-repeat center center fixed;
    background-size: cover;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            max-width: 400px;
            margin: 60px auto;
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
            text-align: center;
        }

        .login-logo img {
            width: 250px;
            margin-bottom: 15px;
        }

        .login-title {
            font-size: 22px;
            font-weight: bold;
            color: red;
            margin-bottom: 5px;
        }


        .login-input {
            width: 94%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 15px;
        }

        .login-checkbox {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            margin: 10px 0 20px;
        }

        .login-button {
            background: linear-gradient(to bottom right, #a31336, #861d2a);
            color: white;
            padding: 12px;
            width: 100%;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .login-button:hover {
            background-color: #a10000;
        }

        .forgot-password {
            color: #007BFF;
            text-decoration: none;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        @media (max-width: 480px) {
            .login-container {
                margin: 20px;
                padding: 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-logo">
            <img src="{{ asset('images/logo.png') }}" alt="ClearMind Logo">
        </div>
        <div class="login-title">Login Account</div>

        {% if error %}
            <div style="color: red;">{{ error }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_patient_login') }}">
            <input type="text" id="patient_id" name="patient_id" class="login-input" placeholder="Patient ID" required>
            <input type="password" id="password" name="password" class="login-input" placeholder="Password" required>

            <div class="login-checkbox">
                <label><input type="checkbox" onclick="togglePassword()"> Show Password</label>
                <a href="#" class="forgot-password">Forget Password?</a>
            </div>

            <button type="submit" class="login-button">Login</button>
        </form>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("password");
            passwordInput.type = passwordInput.type === "password" ? "text" : "password";
        }
    </script>
{% endblock %}
