{% extends 'base.html.twig' %}

{% block title %}Dashboard | Doctor{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid p-0" style="font-family: sans-serif;">
    <div class="d-flex bg-gradient text-white align-items-center p-3 shadow" style="background: linear-gradient(to right, #8e2de2, #4a00e0);">
        <h4 class="mb-0">Doctor Dashboard</h4>
        <div class="ms-auto">
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="doctorDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    {% if doctor.image %}
                        <img src="{{ asset('uploads/doctors/' ~ doctor.image) }}" alt="Profile" width="32" height="32" class="rounded-circle me-2">
                    {% endif %}
                    <strong>{{ doctor.full_name }}</strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="doctorDropdown">
                    <li><a class="dropdown-item" href="#">Show Profile</a></li>
                    <li><a class="dropdown-item disabled text-success">Status: {{ doctor.status }}</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/">Logout</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row m-3">
        <div class="col-md-4">
            <div class="p-4 rounded text-white shadow" style="background: #8224e3;">
                <h6 class="fw-bold">Inactive Patients</h6>
                <p class="fs-2">{{ inactivePatients }}</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded text-white shadow" style="background: #a82dd4;">
                <h6 class="fw-bold">Total Patients</h6>
                <p class="fs-2">{{ patientCount }}</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded text-white shadow" style="background: #bf40bf;">
                <h6 class="fw-bold">Active Patients</h6>
                <p class="fs-2">{{ activePatients }}</p>
            </div>
        </div>
    </div>

    <div class="row m-3">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>Appointment List</span>
                    <button class="btn btn-sm btn-light"><a href="{{ path('app_appointment_new') }}" class="btn btn-sm btn-light">+ New Appointment</a></button>
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>App Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for appt in appointments %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td>{{ appt.name }}</td>
                                    <td>{{ appt.description }}</td>
                                    <td>{{ appt.date|date('Y-m-d') }}</td>
                                    <td>
                                        <span class="badge bg-{{ appt.status == 'Confirmed' ? 'success' : (appt.status == 'Pending' ? 'warning' : 'secondary') }}">{{ appt.status }}</span>
                                    </td>
                                    <td><button class="btn btn-sm btn-outline-primary">See more details</button></td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted">No appointments available</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-info text-white">Patients Overview</div>
                <div class="card-body">
                    <canvas id="patientsChart" height="150"></canvas>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white">Appointments Overview</div>
                <div class="card-body">
                    <canvas id="appointmentsChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const patientCounts = {{ patientCounts|json_encode|raw }};
    const patientDates = {{ patientDates|json_encode|raw }};
    const appointmentCounts = {{ appointmentCounts|json_encode|raw }};
    const appointmentDates = {{ appointmentDates|json_encode|raw }};

    console.log('Patient Counts:', patientCounts);
    console.log('Patient Dates:', patientDates);
    console.log('Appointment Counts:', appointmentCounts);
    console.log('Appointment Dates:', appointmentDates);
    console.log('/////////////////////////////');

    const ctxPatients = document.getElementById('patientsChart').getContext('2d');
    new Chart(ctxPatients, {
        type: 'line',
        data: {
            labels: {{ patientDates|json_encode|raw }},
            datasets: [{
                label: 'Patients',
                data: {{ patientCounts|json_encode|raw }},
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            }
        }
    });

    const ctxAppointments = document.getElementById('appointmentsChart').getContext('2d');
    new Chart(ctxAppointments, {
        type: 'bar',
        data: {
            labels: {{ appointmentDates|json_encode|raw }},
            datasets: [{
                label: 'Appointments',
                data: {{ appointmentCounts|json_encode|raw }},
                backgroundColor: 'rgba(255, 99, 132, 0.5)',
                borderColor: 'rgba(255, 99, 132, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            }
        }
    });
</script>
{% endblock %}
