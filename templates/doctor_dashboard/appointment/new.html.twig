{% extends 'base.html.twig' %}

{% block title %}New Appointment{% endblock %}

{% block body %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5 p-4 rounded shadow bg-light" style="font-family: 'Segoe UI', sans-serif;">
    <div class="mb-4 border-bottom pb-2 d-flex align-items-center">
        <i class="fa-solid fa-calendar-plus fa-2x me-2 text-primary"></i>
        <h2 class="mb-0">Create New Appointment</h2>
    </div>

    <div class="bg-white p-4 rounded shadow-sm">
        {{ form_start(form, {'attr': {'class': 'row g-4'}}) }}

        {% for field in form %}
            <div class="col-md-6">
                <div class="form-floating">
                    {{ form_widget(field, {'attr': {'class': 'form-control', 'placeholder': 'Enter value'}}) }}
                    {{ form_label(field, null, {'label_attr': {'class': 'form-label'}}) }}
                </div>
                <div class="form-text text-danger small">{{ form_errors(field) }}</div>
            </div>
        {% endfor %}

        <div class="col-12 d-flex justify-content-between align-items-center mt-4">
            <a href="{{ path('app_doctor_dashboard') }}" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
            <button class="btn btn-primary px-4">
                <i class="fa-solid fa-paper-plane me-2"></i>Submit Appointment
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
